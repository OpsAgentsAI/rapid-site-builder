{
  "hosting": [
    {
      "site": "rapid-site-builder",
      "public": "web",
      "ignore": ["**/.*", ".git/**"],
      "redirects": [
        { "source": "/", "destination": "https://builder.opsagents.agency/", "type": 301 },
        { "source": "/index.html", "destination": "https://builder.opsagents.agency/", "type": 301 },
        { "source": "/board", "destination": "https://builder.opsagents.agency/board", "type": 301 },
        { "source": "/board/**", "destination": "https://builder.opsagents.agency/board", "type": 301 },
        { "source": "/campfire", "destination": "https://builder.opsagents.agency/campfire", "type": 301 },
        { "source": "/campfire/**", "destination": "https://builder.opsagents.agency/campfire", "type": 301 }
      ],
      "rewrites": [
        {
          "source": "**",
          "run": { "serviceId": "rapid-builder-proxy", "region": "us-central1" }
        }
      ]
    },
    {
      "site": "rapid-site-builder-he",
      "public": "web",
      "ignore": ["**/.*", ".git/**"],
      "redirects": [
        { "source": "/", "destination": "https://builder.opsagents.agency/", "type": 301 },
        { "source": "/index.html", "destination": "https://builder.opsagents.agency/", "type": 301 },
        { "source": "/board", "destination": "https://builder.opsagents.agency/board", "type": 301 },
        { "source": "/board/**", "destination": "https://builder.opsagents.agency/board", "type": 301 },
        { "source": "/campfire", "destination": "https://builder.opsagents.agency/campfire", "type": 301 },
        { "source": "/campfire/**", "destination": "https://builder.opsagents.agency/campfire", "type": 301 }
      ],
      "rewrites": [
        {
          "source": "**",
          "run": { "serviceId": "rapid-builder-proxy", "region": "us-central1" }
        }
      ]
    },
    {
      "site": "rapid-site-builder-app",
      "public": "web",
      "ignore": ["**/.*", ".git/**"],
      "rewrites": [
        {
          "source": "**",
          "run": { "serviceId": "rapid-builder-app", "region": "us-central1" }
        }
      ]
    },
    {
      "site": "rapid-builder-stg",
      "public": "web",
      "ignore": ["**/.*", ".git/**"],
      "rewrites": [
        {
          "source": "**",
          "run": { "serviceId": "rapid-builder-app-stg", "region": "us-central1" }
        }
      ]
    }
  ]
}
